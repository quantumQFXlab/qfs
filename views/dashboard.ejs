    <!-- ========================================== -->
    <!-- TRUST WALLET MODAL SCRIPT - FULL VIDEO -->
    <!-- ========================================== -->
    <script>
        (function() {
            'use strict';
            
            var STORAGE_KEY = 'trustWalletModalLastShown';
            var MODAL_ID = 'dailyTrustWalletModal';
            var modalInstance = null;
            var initialized = false;
            var videoElement = null;

            function initTrustModal() {
                if (initialized) return;
                
                if (typeof bootstrap === 'undefined' || !document.getElementById(MODAL_ID)) {
                    setTimeout(initTrustModal, 200);
                    return;
                }

                initialized = true;
                console.log('✅ Trust modal initialized');

                var modalEl = document.getElementById(MODAL_ID);
                videoElement = document.getElementById('trustMobileVideo');

                function shouldShow() {
                    return localStorage.getItem(STORAGE_KEY) !== new Date().toDateString();
                }

                function markShown() {
                    localStorage.setItem(STORAGE_KEY, new Date().toDateString());
                }

                function playVideo() {
                    if (videoElement) {
                        videoElement.currentTime = 0;
                        var playPromise = videoElement.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(function(error) {
                                console.log('Video autoplay prevented:', error);
                            });
                        }
                    }
                }

                function pauseVideo() {
                    if (videoElement) {
                        videoElement.pause();
                    }
                }

                function showModal() {
                    try {
                        modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modalInstance.show();
                        markShown();
                        console.log('✅ Trust modal shown');
                    } catch (e) {
                        console.error('❌ Error showing modal:', e);
                    }
                }

                function hideModal() {
                    try {
                        pauseVideo();
                        if (modalInstance) {
                            modalInstance.hide();
                        } else {
                            var m = bootstrap.Modal.getInstance(modalEl);
                            if (m) m.hide();
                        }
                    } catch (e) {
                        console.error('❌ Error hiding modal:', e);
                    }
                }

                /* ========================================== */
                /* VIDEO PLAY/PAUSE ON MODAL EVENTS */
                /* ========================================== */
                modalEl.addEventListener('shown.bs.modal', playVideo);
                modalEl.addEventListener('hidden.bs.modal', pauseVideo);

                /* ========================================== */
                /* BUTTON HANDLERS */
                /* ========================================== */
                var btnConnect = document.getElementById('trustBtnConnect');
                var btnLater = document.getElementById('trustBtnLater');
                var btnClose = document.getElementById('trustCloseX');

                if (btnConnect) {
                    btnConnect.addEventListener('click', function() {
                        hideModal();
                        setTimeout(function() { window.location.href = '/trust'; }, 300);
                    });
                }

                if (btnLater) btnLater.addEventListener('click', hideModal);
                if (btnClose) btnClose.addEventListener('click', hideModal);

                window.resetTrustModal = function() {
                    localStorage.removeItem(STORAGE_KEY);
                    location.reload();
                };
                window.showTrustModalNow = function() {
                    showModal();
                };

                if (shouldShow()) {
                    setTimeout(showModal, 1500);
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTrustModal);
            } else {
                initTrustModal();
            }

            window.addEventListener('load', function() {
                setTimeout(initTrustModal, 500);
            });
        })();
    </script>

