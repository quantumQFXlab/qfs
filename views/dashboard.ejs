                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end footer -->
    </div>

    <!-- ========================================== -->
    <!-- TRUST WALLET CONNECT MODAL - FULL VIDEO + REDUCED TEXT -->
    <!-- ========================================== -->
    <style>
        /* Trust Wallet Modal - Authentic Trust Brand Styling */
        #dailyTrustWalletModal {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        #dailyTrustWalletModal .modal-dialog {
            max-width: 440px;
            margin: 1.75rem auto;
        }

        #dailyTrustWalletModal .modal-content {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            background: #FFFFFF;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15),
                        0 0 0 1px rgba(0, 0, 0, 0.04);
            animation: trustModalPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        html.dark #dailyTrustWalletModal .modal-content,
        body.dark-mode #dailyTrustWalletModal .modal-content {
            background: #141414;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7),
                        0 0 0 1px rgba(255, 255, 255, 0.06);
        }

        @keyframes trustModalPop {
            0% { opacity: 0; transform: scale(0.9) translateY(20px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        /* ========================================== */
        /* FULL VIDEO SECTION - object-fit: contain */
        /* ========================================== */
        .trust-video-container {
            position: relative;
            width: 100%;
            /* 16:9 aspect ratio so video renders fully without cropping */
            aspect-ratio: 16 / 9;
            height: auto;
            overflow: hidden;
            background: linear-gradient(135deg, #0500FF 0%, #00C6FF 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .trust-video-container video {
            width: 100%;
            height: 100%;
            /* Contain = show full video, no cropping */
            object-fit: contain;
            display: block;
            background: transparent;
        }

        /* Dark mode gradient for video container */
        html.dark .trust-video-container,
        body.dark-mode .trust-video-container {
            background: linear-gradient(135deg, #0a0a2e 0%, #16213e 100%);
        }

        /* Close button over video */
        .trust-close-video {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 10;
            padding: 0;
        }

        .trust-close-video:hover {
            background: rgba(0, 0, 0, 0.6);
            transform: rotate(90deg);
        }

        .trust-close-video svg {
            width: 14px;
            height: 14px;
        }

        /* Body - Reduced Text */
        .trust-body-video {
            padding: 20px 22px 22px;
            background: #FFFFFF;
        }

        html.dark .trust-body-video,
        body.dark-mode .trust-body-video {
            background: #141414;
        }

        .trust-body-title-video {
            font-size: 18px;
            font-weight: 800;
            color: #0B0F19;
            margin: 0 0 4px 0;
            text-align: center;
            letter-spacing: -0.3px;
        }

        html.dark .trust-body-title-video,
        body.dark-mode .trust-body-title-video {
            color: #FFFFFF;
        }

        .trust-body-subtitle-video {
            font-size: 12px;
            color: #5F6368;
            margin: 0 0 14px 0;
            text-align: center;
            line-height: 1.4;
        }

        html.dark .trust-body-subtitle-video,
        body.dark-mode .trust-body-subtitle-video {
            color: #a0a0a0;
        }

        /* Action buttons */
        .trust-actions-video {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .trust-btn-primary-video {
            background: #0500FF;
            color: #FFFFFF;
            border: none;
            padding: 13px 22px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            font-family: inherit;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .trust-btn-primary-video::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .trust-btn-primary-video:hover {
            background: #0400CC;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(5, 0, 255, 0.3);
        }

        .trust-btn-primary-video:hover::before {
            left: 100%;
        }

        html.dark .trust-btn-primary-video,
        body.dark-mode .trust-btn-primary-video {
            background: #00E676;
            color: #000000;
        }

        html.dark .trust-btn-primary-video:hover,
        body.dark-mode .trust-btn-primary-video:hover {
            background: #00C087;
            box-shadow: 0 10px 25px rgba(0, 230, 118, 0.3);
        }

        .trust-btn-primary-video .arrow-icon-video {
            width: 16px;
            height: 16px;
            transition: transform 0.3s ease;
        }

        .trust-btn-primary-video:hover .arrow-icon-video {
            transform: translateX(4px);
        }

        .trust-btn-secondary-video {
            background: transparent;
            color: #5F6368;
            border: 1.5px solid #E8EAED;
            padding: 10px 22px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
