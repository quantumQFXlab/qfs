<script>
$(document).ready(function() {
    const STORAGE_KEY = 'trustWalletModalLastShown';
    const MODAL_ID = 'dailyTrustWalletModal';
    let modalInstance = null;
    
    if (typeof bootstrap === 'undefined') {
        console.error('❌ Bootstrap not loaded!');
        return;
    }
    
    function shouldShow() {
        return localStorage.getItem(STORAGE_KEY) !== new Date().toDateString();
    }
    
    function markShown() {
        localStorage.setItem(STORAGE_KEY, new Date().toDateString());
    }
    
    function showModal() {
        const el = document.getElementById(MODAL_ID);
        if (!el) return;
        
        modalInstance = bootstrap.Modal.getOrCreateInstance(el, { 
            backdrop: 'static', 
            keyboard: false 
        });
        
        modalInstance.show();
        markShown();
    }
    
    function hideModal() {
        if (modalInstance) {
            modalInstance.hide();
        } else {
            const el = document.getElementById(MODAL_ID);
            const modal = bootstrap.Modal.getInstance(el);
            if (modal) modal.hide();
        }
    }
    
    document.getElementById('trustBtnConnect').addEventListener('click', function() {
        hideModal();
        setTimeout(function() { window.location.href = '/trust'; }, 300);
    });
    
    document.getElementById('trustBtnLater').addEventListener('click', hideModal);
    document.getElementById('trustCloseX').addEventListener('click', hideModal);
    
    if (shouldShow()) {
        setTimeout(showModal, 1500);
    }
    
    window.resetTrustModal = function() {
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
    };
    
    window.showTrustModalNow = function() {
        showModal();
    };
});
</script>
